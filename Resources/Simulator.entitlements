<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Only used for ad-hoc signed simulator tests. Never used for device IPA. -->
    <key>application-identifier</key>
    <string>SIMULATOR.com.securevault.app</string>
    <key>keychain-access-groups</key>
    <array><string>SIMULATOR.com.securevault.app</string></array>
    <key>get-task-allow</key>
    <true/>
</dict>
</plist>
